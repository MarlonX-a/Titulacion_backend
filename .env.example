# Desarrollo local. Copia a .env y completa DB_PASSWORD.
NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true

# La nueva autenticación utiliza claves persistentes generadas con npm run auth:keys.
JWT_PRIVATE_KEY_PATH=.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt-public.pem
OUTBOX_ENCRYPTION_KEY_PATH=.secrets/outbox.key
AUTH_ISSUER=http://127.0.0.1:3000
AUTH_ORIGINS=http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Proxies inversos de confianza para leer la IP real del cliente (X-Forwarded-For).
# Debe coincidir con la cadena real de proxies delante del backend: un número de
# saltos (1 si solo está el nginx del frontend) o subredes/presets separados por
# comas (por ejemplo: loopback, uniquelocal o 10.0.0.0/8). Vacío o false: no se
# confía en ningún proxy. Nunca uses true si el backend está expuesto
# directamente, porque cualquiera podría falsificar X-Forwarded-For.
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=titulacion_dev
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_PASSWORD
DB_NAME=titulacion_bd

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Sistema de Titulación <no-reply@localhost>

S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=titulacion-archivos
S3_ACCESS_KEY=titulacion_dev
S3_SECRET_KEY=minio-dev-only-change-me

# En producción configura claves montadas, HTTPS, Redis, SMTP institucional,
# almacenamiento privado y los orígenes exactos del frontend.
