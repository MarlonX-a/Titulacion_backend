# Desarrollo local. Copia a .env y completa DB_PASSWORD.
NODE_ENV=development
PORT=3000
# Swagger (/docs y /docs-json) se monta solo con SWAGGER_ENABLED=true explícito;
# el valor predeterminado es false en todos los entornos. Actívalo solo en local.
SWAGGER_ENABLED=false

# La nueva autenticación utiliza claves persistentes generadas con npm run auth:keys.
JWT_PRIVATE_KEY_PATH=.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt-public.pem
OUTBOX_ENCRYPTION_KEY_PATH=.secrets/outbox.key
AUTH_ISSUER=http://127.0.0.1:3000
AUTH_ORIGINS=http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Proxies inversos de confianza para leer la IP real del cliente (X-Forwarded-For).
# Debe coincidir con la cadena real de proxies delante del backend: un número de
# saltos (1 si solo está el nginx del frontend) o subredes/presets separados por
# comas (por ejemplo: loopback, uniquelocal o 10.0.0.0/8). Vacío o false: no se
# confía en ningún proxy. Nunca uses true si el backend está expuesto
# directamente, porque cualquiera podría falsificar X-Forwarded-For. En production
# TRUST_PROXY es obligatorio (false, saltos o subredes) y true se rechaza.
TRUST_PROXY=

# Horas de vigencia de la clave temporal (la cédula) de los estudiantes creados por la
# importación de Excel; entero entre 1 y 168, predeterminado 24. Vencida, solo se
# reactiva con "reenviar-acceso" (clave aleatoria por correo). No afecta al alta manual.
IMPORT_TEMP_TTL_HOURS=24

# Tareas periódicas en segundo plano (scheduler de transiciones de período por fecha y
# barridos de exportaciones y limpieza de archivos). Predeterminado: true. Solo las
# pruebas automatizadas lo desactivan; no lo cambies en desarrollo. En production el arranque
# rechaza BACKGROUND_TASKS_ENABLED=false.
BACKGROUND_TASKS_ENABLED=true
# true: la configuración se toma solo de las variables del proceso y no se lee .env.
# Predeterminado: false. Las pruebas automatizadas lo activan (test/setup-env.ts). Se lee
# antes de cargar .env: solo surte efecto como variable del proceso, no escrita en este archivo.
IGNORE_ENV_FILE=false

DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=titulacion_dev
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_PASSWORD
DB_NAME=titulacion_bd
# TLS con PostgreSQL. Predeterminado: true en production y false en otros entornos.
# DB_SSL_REJECT_UNAUTHORIZED (predeterminado true) verifica el certificado del servidor.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Contraseña de Redis (obligatoria en production) y TLS (predeterminado false).
# docker-compose.yml arranca Redis con --requirepass y se niega a iniciar sin ella:
# genera un valor aleatorio largo (por ejemplo: openssl rand -hex 24) y no lo versiones.
REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD
REDIS_TLS=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Sistema de Titulación <no-reply@localhost>
# Exige STARTTLS con el servidor SMTP. Predeterminado: true en production y false en otros entornos.
SMTP_REQUIRE_TLS=false
# Credenciales del servidor SMTP: se configuran juntas o ninguna (Mailpit local no las usa).
# SMTP_USERNAME=usuario-smtp
# SMTP_PASSWORD=CAMBIAR_SMTP_PASSWORD

S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=titulacion-archivos
S3_ACCESS_KEY=titulacion_dev
# docker-compose.yml exige S3_ACCESS_KEY y S3_SECRET_KEY (sin valores por defecto).
S3_SECRET_KEY=CAMBIAR_S3_SECRET_KEY

# En producción configura claves montadas, HTTPS, Redis, SMTP institucional,
# almacenamiento privado y los orígenes exactos del frontend.
