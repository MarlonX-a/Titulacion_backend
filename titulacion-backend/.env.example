# Valores de desarrollo. Sustituye la contraseña por la de tu instalación local.
NODE_ENV=development
PORT=3000
AUTH_MODE=institutional

# Opcional: true o false. Si se omite, se deshabilita en production.
# Para usar ese valor automático, elimina o comenta la siguiente línea.
SWAGGER_ENABLED=true

DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_PASSWORD
DB_NAME=titulacion_bd

# Solo para pruebas locales. Descomenta las siguientes líneas en .env para
# utilizar cuentas ficticias; AUTH_MODE=local exige DB_SCHEMA=local_demo.
# AUTH_MODE=local
# DB_SCHEMA=local_demo
# LOCAL_AUTH_PASSWORD=define-aqui-una-clave-local-de-16-caracteres

# Configura las tres variables solo cuando tengas los datos del proveedor
# institucional. Sustituye los marcadores por sus URLs y audiencia reales.
# OIDC_ISSUER=https://<emisor-indicado-por-la-institucion>
# OIDC_AUDIENCE=<audiencia-registrada-para-esta-api>
# JWKS_URI=https://<url-de-claves-indicada-por-la-institucion>
